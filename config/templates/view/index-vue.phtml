<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><?=$title; ?></title>
    <link rel="icon" href="https://www.popphp.org/assets/img/pop-php-icon.png">
    <script>
        (function () {
            var stored = localStorage.getItem('theme');
            if (stored === 'dark' || (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.classList.add('dark');
            }
        })();
    </script>
    <link rel="stylesheet" href="/assets/css/app.css">
</head>
<body class="min-h-screen flex flex-col bg-slate-50 dark:bg-slate-900 font-sans text-slate-900 dark:text-slate-100">
    <button type="button" id="theme-toggle" aria-label="Toggle dark mode" class="fixed top-4 right-4 inline-flex items-center justify-center w-10 h-10 rounded-full border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-500 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 transition">
        <svg id="theme-toggle-moon" class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z"/>
        </svg>
        <svg id="theme-toggle-sun" class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" style="display:none">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"/>
        </svg>
    </button>
    <div class="w-full bg-pop-orange-light flex items-center justify-center py-14 px-6">
        <img src="https://media.popphp.org/img/pop-php-logo-white.png" alt="Pop PHP" class="w-44 h-44">
    </div>
    <div class="flex-1 flex flex-col items-center text-center px-6 pt-10 pb-12">
        <div class="w-full max-w-md">
            <span class="inline-block text-xs font-bold uppercase tracking-wider text-orange-700 dark:text-orange-400 mb-3">Vue.js + Tailwind</span>
            <h1 class="text-5xl font-light mb-3 tracking-tight text-stone-600 dark:text-stone-300"><?=$title;?></h1>
            <p class="text-slate-500 dark:text-slate-400 leading-relaxed mb-8">Your Pop PHP application is up and running.</p>

            <div id="app"></div>

            <footer class="mt-10 text-sm text-slate-500 dark:text-slate-400">
                Built with <a href="https://www.popphp.org" target="_blank" rel="noopener" class="text-orange-700 dark:text-orange-400 font-semibold hover:underline">Pop PHP</a>
            </footer>
        </div>
    </div>
    <script type="module" src="/assets/js/app.js"></script>
    <script>
        (function () {
            var root = document.documentElement;
            var toggle = document.getElementById('theme-toggle');
            var moonIcon = document.getElementById('theme-toggle-moon');
            var sunIcon = document.getElementById('theme-toggle-sun');

            function syncIcons() {
                var isDark = root.classList.contains('dark');
                moonIcon.style.display = isDark ? 'none' : '';
                sunIcon.style.display = isDark ? '' : 'none';
            }

            toggle.addEventListener('click', function () {
                root.classList.toggle('dark');
                localStorage.setItem('theme', root.classList.contains('dark') ? 'dark' : 'light');
                syncIcons();
            });

            syncIcons();
        })();
    </script>
</body>
</html>
