<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><?=$title; ?></title>
    <link rel="icon" href="https://www.popphp.org/assets/img/pop-php-icon.png">
    <link rel="stylesheet" href="/assets/css/app.css">
</head>
<body class="min-h-screen flex flex-col bg-slate-50 font-sans text-slate-900">
    <div class="w-full bg-pop-orange-light flex items-center justify-center py-14 px-6">
        <img src="https://media.popphp.org/img/pop-php-logo-white.png" alt="Pop PHP" class="w-44 h-44">
    </div>
    <div class="flex-1 flex flex-col items-center text-center px-6 pt-10 pb-12">
        <div class="w-full max-w-md">
            <span class="inline-block text-xs font-bold uppercase tracking-wider text-orange-700 mb-3">Alpine.js + Tailwind</span>
            <h1 class="text-5xl font-light mb-3 tracking-tight text-stone-600"><?=$title;?></h1>
            <p class="text-slate-500 leading-relaxed mb-8">Your Pop PHP application is up and running.</p>

            <div x-data="{ count: 0 }" class="inline-flex items-center gap-4 bg-white border border-slate-200 rounded-lg px-5 py-3">
                <span class="text-sm text-slate-500">Alpine is working</span>
                <button
                    type="button"
                    @click="count++"
                    class="px-3 py-1.5 text-sm font-semibold text-white bg-orange-700 rounded-md hover:bg-orange-800 transition"
                >
                    Count: <span x-text="count"></span>
                </button>
            </div>

            <footer class="mt-10 text-sm text-slate-500">
                Built with <a href="https://www.popphp.org" target="_blank" rel="noopener" class="text-orange-700 font-semibold hover:underline">Pop PHP</a>
            </footer>
        </div>
    </div>
    <script type="module" src="/assets/js/app.js"></script>
</body>
</html>
