{
    "name": "popphp/pop-kettle",
    "description": "A CLI helper application for the Pop PHP Framework.",
    "keywords": [
        "console helper",
        "CLI helper",
        "pop",
        "pop php",
        "php"
    ],
    "homepage": "https://github.com/popphp/pop-kettle",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Nick Sagona",
            "email": "dev@noladev.com",
            "homepage": "https://www.popphp.org/"
        }
    ],
    "require": {
        "php": ">=8.4.0",
        "popphp/popphp": "^5.0.1",
        "popphp/pop-code": "^6.0.0",
        "popphp/pop-console": "^5.0.2",
        "popphp/pop-db": "^7.0.0",
        "popphp/pop-dir": "^5.0.0",
        "popphp/pop-queue": "^3.0.0",
        "popphp/pop-utils": "^3.0.0",
        "vlucas/phpdotenv": "^5.6.4"
    },
    "require-dev": {
        "popphp/pop-view": "^5.0.0",
        "phpunit/phpunit": "^12.5.0",
        "phpstan/phpstan": "^2.2",
        "ext-sqlite3": "*"
    },
    "autoload": {
        "psr-4": {
            "Pop\\Kettle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pop\\Kettle\\Test\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "3.0.x-dev"
        }
    }
}
